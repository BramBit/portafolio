---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';

// Fetch content collections
const caseStudies = await getCollection('case-studies');
const featuredCaseStudies = caseStudies
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const engineeringArticles = await getCollection('engineering');
const featuredEngineering = engineeringArticles
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const products = await getCollection('products');
const featuredProducts = products.sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));

const servicesSample = [
  {
    title: 'Arquitectura de Sistemas & Escalabilidad',
    description: 'Diseño y desarrollo de arquitecturas resilientes capaces de soportar alto tráfico y operaciones críticas de negocio.',
    technologies: ['Distributed Systems', 'Microservices', 'Cloud Architecture']
  },
  {
    title: 'Desarrollo de Plataformas Empresariales',
    description: 'Construcción de aplicaciones web completas end-to-end enfocadas en rendimiento, mantenibilidad y valor estratégico.',
    technologies: ['Full Stack', 'Astro', 'TypeScript', 'Node.js']
  },
  {
    title: 'IA Aplicada & Automatización',
    description: 'Integración de modelos de lenguaje, sistemas RAG y pipelines de automatización inteligente para optimizar procesos.',
    technologies: ['RAG Systems', 'LLM Integration', 'Vector Databases']
  },
  {
    title: 'Consultoría Técnica & Lead Engineering',
    description: 'Acompañamiento estratégico en decisiones de software, auditoría de código, optimización de rendimiento y buenas prácticas.',
    technologies: ['Code Audit', 'Performance Optimization', 'Technical Leadership']
  }
];
---

<Layout
  title="Brayan Mercado — Software Engineer"
  description="Building scalable products, intelligent systems and AI-powered experiences."
>
  <!-- Hero Section -->
  <Hero
    title="Brayan Mercado"
    subtitle="Software Engineer"
    description="Building scalable products, intelligent systems and AI-powered experiences."
    primaryButton={{ label: 'Ver Case Studies', href: '/case-studies' }}
    secondaryButton={{ label: 'Contacto', href: '/contact' }}
  />

  <!-- Services Preview Section -->
  <Section id="services">
    <Container>
      <div class="section-header">
        <Heading level={2}>Capacidades & Servicios</Heading>
        <p class="section-subtitle">
          Soluciones de ingeniería orientadas a resolver problemas complejos y escalar productos.
        </p>
      </div>

      <div class="grid-two-cols">
        {
          servicesSample.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Featured Case Studies Section -->
  <Section id="case-studies">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Featured Case Studies</Heading>
          <p class="section-subtitle">
            Proyectos reales de gran escala: el problema de negocio, la arquitectura y los resultados obtenidos.
          </p>
        </div>
        <Button variant="secondary" href="/case-studies">Ver todos los casos</Button>
      </div>

      <div class="grid-cards">
        {
          featuredCaseStudies.map((study) => (
            <CaseStudyCard
              title={study.data.title}
              summary={study.data.summary}
              technologies={study.data.technologies}
              slug={study.data.slug}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Engineering Highlights Section -->
  <Section id="engineering">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Engineering Highlights</Heading>
          <p class="section-subtitle">
            Artículos y desgloses técnicos profundos sobre arquitectura, IA aplicada y soluciones de ingeniería.
          </p>
        </div>
        <Button variant="secondary" href="/engineering">Ver todos los artículos</Button>
      </div>

      <div class="grid-cards">
        {
          featuredEngineering.map((article) => (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              readingTime={article.data.readingTime}
              tags={article.data.tags}
              slug={article.data.slug}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Featured Products Section -->
  <Section id="products">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Productos Propios</Heading>
          <p class="section-subtitle">
            Plataformas y soluciones SaaS diseñadas e impulsadas por tecnología e inteligencia artificial.
          </p>
        </div>
        <Button variant="secondary" href="/products">Ver todos los productos</Button>
      </div>

      <div class="grid-two-cols">
        {
          featuredProducts.map((product) => (
            <ProductCard
              title={product.data.title}
              tagline={product.data.tagline}
              status={product.data.status}
              link={product.data.website}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- About Preview Section -->
  <Section id="about-preview">
    <Container>
      <div class="about-box">
        <div class="about-content">
          <Heading level={2}>Sobre mí</Heading>
          <p class="about-text">
            Soy Software Engineer enfocado en diseñar y construir sistemas escalables, plataformas empresariales e integraciones de IA avanzada. Trabajo colaborando estrechamente con fundadores y equipos para transformar requisitos complejos de negocio en productos técnicos sólidos.
          </p>
          <div class="about-action">
            <Button variant="secondary" href="/about">Conocer más sobre mi trayectoria →</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Final CTA Section -->
  <CTASection
    title="¿Tienes un proyecto o sistema complejo en mente?"
    description="Hablemos sobre cómo puedo ayudarte a construir una arquitectura escalable o potenciar tu producto con IA."
    button={{ label: 'Iniciar Conversación', href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .section-header {
    margin-bottom: var(--space-8, 32px);
  }

  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 16px);
    margin-bottom: var(--space-8, 32px);
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-2, 8px);
    max-width: 640px;
  }

  .grid-two-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .grid-two-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .grid-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-elevated);
    border-radius: 12px;
    padding: var(--space-8, 32px);
  }

  .about-content {
    max-width: 800px;
  }

  .about-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    line-height: 1.6;
    margin-top: var(--space-4, 16px);
    margin-bottom: var(--space-6, 24px);
  }

  .about-action {
    display: flex;
  }
</style>
