---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MobileTrack from '../components/MobileTrack.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ExperienceGroups from '../components/ExperienceGroups.astro';
import StackGroups from '../components/StackGroups.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';
import { getExperienceGroups } from '../data/experience';
import { buildStackGroups } from '../data/stack';
import { servicesEN } from '../data/services';
import { siteConfig } from '../data/site';

const byNewest = <T extends { data: { publishedAt: Date } }>(a: T, b: T) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

// Experience: every case study of this language, grouped by company
const caseStudies = (await getCollection('case-studies'))
  .filter((c) => c.id.startsWith('en/'))
  .sort(byNewest);

const experienceGroups = getExperienceGroups(caseStudies, 'en');

const productOrder = ['product-checkout-platform', 'pliegos'];
const products = (await getCollection('products'))
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => {
    const idxA = productOrder.indexOf(a.data.slug);
    const idxB = productOrder.indexOf(b.data.slug);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
  });

// Stack: documented case studies, services, and product technologies
const stackGroups = buildStackGroups({
  lang: 'en',
  cases: caseStudies.map((study) => ({ slug: study.data.slug, technologies: study.data.technologies })),
  services: servicesEN.map((service) => ({ slug: service.id, technologies: service.technologies })),
});

// Verified contact channels (src/data/site.ts)
const contacts = [
  { label: 'Email', value: siteConfig.email, href: `mailto:${siteConfig.email}` },
  { label: 'LinkedIn', value: 'brayan-mercado-sanmartin', href: siteConfig.social.linkedin, external: true },
  { label: 'GitHub', value: 'BramBit', href: siteConfig.social.github, external: true },
];
---

<Layout
  title="Brayan Mercado — Full Stack Software Engineer"
  description="I design and build full-stack features, backend systems, and applied AI capabilities for real products."
>
  <!-- Hero Section (Section 4 EN) -->
  <Hero
    title="I build end-to-end software: interfaces, APIs, architecture, and applied AI."
    subtitle="Brayan Mercado — Full Stack Software Engineer"
    description="I develop Full Stack features and backend systems, integrating interfaces, APIs, data, and AI into a single solution."
    primaryButton={{ label: 'See the work', href: '/case-studies' }}
    secondaryButton={{ label: "Let's talk about your project", href: '/contact' }}
    meta={[
      { label: 'Currently', value: 'Co-Founder & Full Stack Software Engineer at Alaska Tech' },
      { label: 'Ecosystem', value: 'TypeScript' },
      { label: 'Focus', value: 'Full Stack, Backend, Applied AI, Software Architecture' },
    ]}
  />

  <!-- 01 Products: the featured project leads the page -->
  <Section id="products">
    <Container>
      <SectionHeader
        index="01"
        title="Products"
        href="/products"
        linkLabel="View all products"
      />
      <MobileTrack id="product-previews" label="Products" count={products.length} layout="products">
        {
          products.map((product, i) => (
            <ProjectFeature
              title={product.data.title}
              tagline={product.data.tagline}
              status={product.data.status}
              capabilities={product.data.capabilities}
              problem={product.data.problem}
              solution={product.data.solution}
              href={`/products/${product.data.slug}`}
              website={product.data.website}
              reverse={i % 2 === 1}
            />
          ))
        }
      </MobileTrack>
    </Container>
  </Section>

  <!-- 02 Experience: grouped by company, every case study included -->
  <Section id="case-studies">
    <Container>
      <SectionHeader
        index="02"
        title="Experience"
        href="/case-studies"
        linkLabel="View all experience"
      />
      <ExperienceGroups groups={experienceGroups} lang="en" />
    </Container>
  </Section>

  <!-- 03 Services -->
  <Section id="services">
    <Container>
      <SectionHeader
        index="03"
        title="Services"
        href="/services"
        linkLabel="View all services"
        description="Every solution starts with the problem you need to solve. Technology is chosen based on goals, scale, and operational realities."
      />
      <MobileTrack id="service-previews" label="Services" count={servicesEN.length} layout="services">
        {
          servicesEN.map((service) => (
            <ServiceCard service={service} />
          ))
        }
      </MobileTrack>
    </Container>
  </Section>

  <!-- 04 Tech stack -->
  <Section id="stack">
    <Container>
      <SectionHeader index="04" title="Tech stack" description="Technologies documented in case studies, products, and services, organized by layer." />
      <StackGroups groups={stackGroups} />
    </Container>
  </Section>

  <!-- About Preview Section (Section 16 EN) -->
  <Section id="about-preview">
    <Container>
      <div class="about-box" data-reveal>
        <div class="about-content">
          <SectionHeader index="05" title="About Me" />
          <p class="about-text">
            I didn't start out building software. I started as a food engineer, learning to model processes, control quality, and solve problems with structure and analysis — long before I touched a line of TypeScript.
          </p>
          <p class="about-text">
            That changed when I moved into software: first building interfaces, then backend systems, and eventually taking on architecture decisions end to end...
          </p>
          <div class="about-action">
            <Button variant="secondary" href="/about">Read more →</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
    contacts={contacts}
  />
</Layout>

<style>
  :global(#stack) { padding-bottom: var(--space-64); }
  :global(#about-preview) { padding-top: var(--space-64); }

  .about-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-32);
  }

  .about-content {
    max-width: 800px;
  }

  .about-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg);
    line-height: 1.6;
    margin-top: var(--space-16);
    margin-bottom: var(--space-16);
  }

  .about-action {
    display: flex;
    margin-top: var(--space-24);
  }
</style>
