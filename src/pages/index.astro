---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import StackGroups from '../components/StackGroups.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';
import { groupByCompany } from '../data/experience';
import { buildStackGroups } from '../data/stack';
import { servicesEN } from '../data/services';
import { siteConfig } from '../data/site';

const byNewest = <T extends { data: { publishedAt: Date } }>(a: T, b: T) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

// Experience: every case study of this language, grouped by company
const caseStudies = (await getCollection('case-studies'))
  .filter((c) => c.id.startsWith('en/'))
  .sort(byNewest);

const experienceGroups = groupByCompany(
  caseStudies.map((study) => ({
    title: study.data.title,
    summary: study.data.impactSummary ?? study.data.summary,
    role: study.data.role,
    timeframe: study.data.timeframe,
    company: study.data.company,
    technologies: study.data.technologies,
    href: `/case-studies/${study.data.slug}`,
  }))
);

const engineeringArticles = (await getCollection('engineering'))
  .filter((e) => e.id.startsWith('en/'))
  .sort(byNewest)
  .slice(0, 3);

const productOrder = ['product-checkout-platform', 'pliegos'];
const products = (await getCollection('products'))
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => {
    const idxA = productOrder.indexOf(a.data.slug);
    const idxB = productOrder.indexOf(b.data.slug);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
  });

// Stack: only technologies already documented in the case studies and services
const stackGroups = buildStackGroups({
  projects: caseStudies.map((study) => study.data.technologies),
  extra: servicesEN.flatMap((service) => service.technologies),
  labels: { backend: 'Backend', frontend: 'Frontend', data: 'Data & Storage', ai: 'Applied AI', infra: 'Infrastructure & Tools' },
  usage: (n) => `${n} projects`,
});

// Verified contact channels (src/data/site.ts)
const contacts = [
  { label: 'Email', value: siteConfig.email, href: `mailto:${siteConfig.email}` },
  { label: 'LinkedIn', value: 'brayan-mercado-sanmartin', href: siteConfig.social.linkedin, external: true },
  { label: 'GitHub', value: 'BramBit', href: siteConfig.social.github, external: true },
];
---

<Layout
  title="Brayan Mercado — Full Stack Software Engineer"
  description="I design and build full-stack features, backend systems, and applied AI capabilities for real products."
>
  <!-- Hero Section (Section 4 EN) -->
  <Hero
    title="I build end-to-end software: interfaces, APIs, architecture, and applied AI."
    subtitle="Brayan Mercado — Full Stack Software Engineer"
    description="I develop Full Stack features and backend systems, integrating interfaces, APIs, data, and AI into a single solution."
    primaryButton={{ label: 'See the work', href: '/case-studies' }}
    secondaryButton={{ label: "Let's talk about your project", href: '/contact' }}
    meta={[
      { label: 'Currently', value: 'Co-Founder & Full Stack Software Engineer at Alaska Tech' },
      { label: 'Ecosystem', value: 'TypeScript' },
      { label: 'Focus', value: 'Full Stack, Backend, Applied AI, Software Architecture' },
    ]}
  />

  <!-- 01 Products: the featured project leads the page -->
  <Section id="products">
    <Container>
      <SectionHeader
        index="01"
        title="Products"
        href="/products"
        linkLabel="View all products"
      />
      <div class="feature-list">
        {
          products.map((product, i) => (
            <ProjectFeature
              title={product.data.title}
              tagline={product.data.tagline}
              status={product.data.status}
              problem={product.data.problem}
              solution={product.data.solution}
              href={`/products/${product.data.slug}`}
              website={product.data.website}
              reverse={i % 2 === 1}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 02 Engineering: documented technical decisions -->
  <Section id="engineering">
    <Container>
      <SectionHeader
        index="02"
        title="Engineering"
        href="/engineering"
        linkLabel="View all articles"
      />
      <div class="grid-cards" data-reveal>
        {
          engineeringArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              readingTime={article.data.readingTime}
              tags={article.data.tags}
              slug={article.data.slug}
              href={`/engineering/${article.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 03 Experience: grouped by company, every case study included -->
  <Section id="case-studies">
    <Container>
      <SectionHeader
        index="03"
        title="Experience"
        href="/case-studies"
        linkLabel="View all experience"
      />
      <ExperienceTimeline groups={experienceGroups} />
    </Container>
  </Section>

  <!-- 04 Services -->
  <Section id="services">
    <Container>
      <SectionHeader
        index="04"
        title="Services"
        href="/services"
        linkLabel="View all services"
        description="Every solution starts with the problem you need to solve. Technology is chosen based on goals, scale, and operational realities."
      />
      <div class="grid-two-cols" data-reveal>
        {
          servicesEN.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 05 Tech stack -->
  <Section id="stack">
    <Container>
      <SectionHeader index="05" title="Tech stack" description="Grouped by layer. Highlighted technologies appear in more than one documented project." />
      <StackGroups groups={stackGroups} />
    </Container>
  </Section>

  <!-- About Preview Section (Section 16 EN) -->
  <Section id="about-preview">
    <Container>
      <div class="about-box" data-reveal>
        <div class="about-content">
          <SectionHeader index="06" title="About Me" />
          <p class="about-text">
            I didn't start out building software. I started as a food engineer, learning to model processes, control quality, and solve problems with structure and analysis — long before I touched a line of TypeScript.
          </p>
          <p class="about-text">
            That changed when I moved into software: first building interfaces, then backend systems, and eventually taking on architecture decisions end to end...
          </p>
          <div class="about-action">
            <Button variant="secondary" href="/about">Read more →</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
    contacts={contacts}
  />
</Layout>

<style>
  .feature-list {
    display: grid;
    gap: var(--space-32);
  }

  .grid-two-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-24);
  }

  .grid-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-24);
  }

  @media (min-width: 768px) {
    .grid-two-cols,
    .grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-32);
  }

  .about-content {
    max-width: 800px;
  }

  .about-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg);
    line-height: 1.6;
    margin-top: var(--space-16);
    margin-bottom: var(--space-16);
  }

  .about-action {
    display: flex;
    margin-top: var(--space-24);
  }
</style>
