---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import Button from '../components/Button.astro';

// Fetch content collections for EN
const caseStudies = await getCollection('case-studies');
const enCaseStudies = caseStudies
  .filter((c) => c.id.startsWith('en/'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

// Impact summaries map for EN case studies (Section 11 EN)
const impactSummaries: Record<string, string> = {
  zeus: 'Developed full-stack and backend capabilities for an IoT platform covering device usage, financial reporting, support, and applied AI.',
  plei: 'Replaced Algolia with a custom hybrid search engine and built reusable RAG and AI support capabilities for the platform.',
  veciapp: 'Designed and built the backend for a multi-role marketplace connecting local merchants with their customers.',
  maleua: 'Built a static institutional website with a content structure designed for simple maintenance.',
};

const engineeringArticles = await getCollection('engineering');
const enEngineering = engineeringArticles
  .filter((e) => e.id.startsWith('en/'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const products = await getCollection('products');
const enProducts = products
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));

// Services in exact order from Section 5 EN
const servicesEN = [
  {
    title: 'AI Systems',
    description: 'RAG systems, semantic search, specialized chatbots, and document processing integrated into existing applications.',
    technologies: ['RAG', 'Embeddings', 'pgvector', 'OpenAI'],
  },
  {
    title: 'Backend Development',
    description: 'Backend services, business logic, data modeling, and persistence for digital products.',
    technologies: ['Node.js', 'TypeScript', 'Express', 'Laravel'],
  },
  {
    title: 'Full Stack Development',
    description: 'End-to-end features from data models and business logic through APIs and interfaces.',
    technologies: ['TypeScript', 'Node.js', 'React', 'Next.js'],
  },
  {
    title: 'APIs & Integrations',
    description: 'REST APIs and integrations between applications and external services.',
    technologies: ['REST', 'Node.js', 'PostgreSQL', 'Webhooks'],
  },
  {
    title: 'Software Architecture',
    description: 'Architecture and structural decisions applied according to the actual needs of the product.',
    technologies: ['DDD', 'Hexagonal Architecture', 'Event-Driven'],
  },
  {
    title: 'Technical Review',
    description: 'Review of architecture, implementation decisions, and structural problems before more work is built on top of them.',
    technologies: ['Architecture', 'Backend', 'APIs', 'Software Design'],
  },
];
---

<Layout
  title="Brayan Mercado — Full Stack Software Engineer"
  description="I design and build full-stack features, backend systems, and applied AI capabilities for real products."
>
  <!-- Hero Section (Section 4 EN) -->
  <Hero
    title="I build end-to-end software: interfaces, APIs, architecture, and applied AI."
    subtitle="Brayan Mercado — Full Stack Software Engineer"
    description="I develop Full Stack features and backend systems, integrating interfaces, APIs, data, and AI into a single solution."
    primaryButton={{ label: 'See the work', href: '/case-studies' }}
    secondaryButton={{ label: "Let's talk about your project", href: '/contact' }}
  />

  <!-- Services Preview Section (Section 5 EN) -->
  <Section id="services">
    <Container>
      <div class="section-header">
        <Heading level={2}>Services</Heading>
      </div>

      <div class="grid-two-cols horizontal-scroll-mobile">
        {
          servicesEN.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Featured Experience Section (Section 8 EN) -->
  <Section id="case-studies">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Experience</Heading>
        </div>
        <Button variant="secondary" href="/case-studies">View all experience</Button>
      </div>

      <div class="grid-cards horizontal-scroll-mobile">
        {
          enCaseStudies.map((study) => (
            <CaseStudyCard
              title={study.data.title}
              summary={impactSummaries[study.data.slug] || study.data.summary}
              technologies={study.data.technologies}
              slug={study.data.slug}
              href={`/case-studies/${study.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Engineering Highlights Section (Section 13 EN) -->
  <Section id="engineering">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Engineering</Heading>
        </div>
        <Button variant="secondary" href="/engineering">View all articles</Button>
      </div>

      <div class="grid-cards horizontal-scroll-mobile">
        {
          enEngineering.map((article) => (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              readingTime={article.data.readingTime}
              tags={article.data.tags}
              slug={article.data.slug}
              href={`/engineering/${article.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- Featured Products Section (Section 18 EN) -->
  <Section id="products">
    <Container>
      <div class="section-header-flex">
        <div>
          <Heading level={2}>Products</Heading>
        </div>
        <Button variant="secondary" href="/products">View all products</Button>
      </div>

      <div class="grid-two-cols horizontal-scroll-mobile">
        {
          enProducts.map((product) => (
            <ProductCard
              title={product.data.title}
              tagline={product.data.tagline}
              status={product.data.status}
              link={product.data.website}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- About Preview Section (Section 16 EN) -->
  <Section id="about-preview">
    <Container>
      <div class="about-box">
        <div class="about-content">
          <Heading level={2}>About Me</Heading>
          <p class="about-text">
            I didn't start out building software. I started as a food engineer, learning to model processes, control quality, and solve problems with structure and analysis — long before I touched a line of TypeScript.
          </p>
          <p class="about-text">
            That changed when I moved into software: first building interfaces, then backend systems, and eventually taking on architecture decisions end to end...
          </p>
          <div class="about-action">
            <Button variant="secondary" href="/about">Read more →</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Final CTA Section (Section 7 EN) -->
  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .section-header {
    margin-bottom: var(--space-8, 32px);
  }

  .section-header-flex {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 16px);
    margin-bottom: var(--space-8, 32px);
  }

  @media (min-width: 768px) {
    .section-header-flex {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-2, 8px);
    max-width: 640px;
  }

  .grid-two-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .grid-two-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .grid-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .about-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-elevated);
    border-radius: 12px;
    padding: var(--space-8, 32px);
  }

  .about-content {
    max-width: 800px;
  }

  .about-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    line-height: 1.6;
    margin-top: var(--space-4, 16px);
    margin-bottom: var(--space-4, 16px);
  }

  .about-action {
    display: flex;
    margin-top: var(--space-6, 24px);
  }
</style>
