---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';
import { servicesEN } from '../data/services';
---

<Layout
  title="Software Engineering Services — Brayan Mercado"
  description="Custom software development, automation, applied AI, and software evolution tailored to real business processes."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Software Engineering Services</Heading>
      <p class="page-subtitle">
        Custom software development, automation, applied AI, and software evolution tailored to real business processes.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <h2 class="visually-hidden">All Services</h2>
      <div class="services-grid">
        {
          servicesEN.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8, 32px);
    }
  }
</style>
