---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTASection from '../components/CTASection.astro';

// Section 6 EN - 6 service cards from docs/00_COPY_MAESTRO_WEB_BILINGUE_V3.md
const servicesEN = [
  {
    title: 'AI Systems',
    description: 'Design and implementation of RAG systems, semantic search, specialized chatbots, and document processing integrated into existing applications.',
    technologies: ['RAG', 'Embeddings', 'pgvector', 'OpenAI'],
  },
  {
    title: 'Backend Development',
    description: 'Design and implementation of backend services, business logic, and persistence for digital products.',
    technologies: ['Node.js', 'TypeScript', 'Express', 'Laravel'],
  },
  {
    title: 'Full Stack Development',
    description: 'End-to-end feature development, from data models and business logic to APIs and the interface.',
    technologies: ['TypeScript', 'Node.js', 'React', 'Next.js'],
  },
  {
    title: 'APIs & Integrations',
    description: 'Design and implementation of REST APIs and integrations between applications and external services.',
    technologies: ['REST', 'Node.js', 'PostgreSQL', 'Webhooks'],
  },
  {
    title: 'Software Architecture',
    description: 'Design and evolution of software structures using architectural patterns and principles where they solve an actual product problem.',
    technologies: ['DDD', 'Hexagonal Architecture', 'Event-Driven'],
  },
  {
    title: 'Technical Review',
    description: 'Review of architecture, implementation decisions, and structural problems before more work is built on top of them.',
    technologies: ['Architecture', 'Backend', 'APIs', 'Software Design'],
  },
];
---

<Layout
  title="Software Engineering Services — Brayan Mercado"
  description="Full Stack development, backend engineering, software architecture, and applied AI integration for digital products."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Software Engineering Services</Heading>
      <p class="page-subtitle">
        Full Stack development, backend engineering, software architecture, and applied AI integration for digital products.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="services-grid horizontal-scroll-mobile">
        {
          servicesEN.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8, 32px);
    }
  }
</style>
