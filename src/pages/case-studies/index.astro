---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import CTASection from '../../components/CTASection.astro';

const caseStudies = await getCollection('case-studies');

// Filter case studies for EN
const enCaseStudies = caseStudies
  .filter((c) => c.id.startsWith('en/') || !c.id.startsWith('es/'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout
  title="Experience — Brayan Mercado | Software Engineer"
  description="Projects I've worked on and the software systems I helped build across frontend, backend, and applied AI."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Experience</Heading>
      <p class="page-subtitle">
        Projects I've worked on and the software systems I helped build across frontend, backend, and applied AI.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="case-studies-grid horizontal-scroll-mobile">
        {
          enCaseStudies.map((study) => (
            <CaseStudyCard
              title={study.data.title}
              summary={study.data.impactSummary || study.data.summary}
              technologies={study.data.technologies}
              slug={study.data.slug}
              href={`/case-studies/${study.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .case-studies-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .case-studies-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .case-studies-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
