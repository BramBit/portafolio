---
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
export async function getStaticPaths() {
  const studies = (await getCollection('case-studies')).filter((study) => study.id.startsWith('en/'));
  return studies.map((study) => ({ params: { slug: study.data.slug }, props: { study } }));
}
const { study } = Astro.props;
---
<CaseStudyLayout study={study} lang="en" />
