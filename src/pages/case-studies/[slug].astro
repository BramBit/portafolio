---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import Tag from '../../components/Tag.astro';
import CTASection from '../../components/CTASection.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  const enStudies = caseStudies.filter((study) => study.id.startsWith('en/'));
  return enStudies.map((study) => ({
    params: { slug: study.data.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<Layout
  title={`${study.data.title} — Experience | Brayan Mercado`}
  description={study.data.impactSummary || study.data.summary}
>
  <!-- Header Section -->
  <Section class="header-section">
    <Container>
      <div class="breadcrumb">
        <a href="/case-studies" class="back-link">
          <svg viewBox="0 0 24 24" stroke="currentColor" fill="none" class="back-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to Experience
        </a>
      </div>

      <Heading level={1} class="title">{study.data.title}</Heading>

      <p class="summary">{study.data.impactSummary || study.data.summary}</p>

      <div class="meta-grid">
        {
          (study.data.company || study.data.role || study.data.timeframe) && (
            <div class="quick-facts-card">
              <span class="meta-label">Quick facts:</span>
              <dl class="facts-list">
                {study.data.company && (
                  <div class="fact-item">
                    <dt class="fact-key">Company:</dt>
                    <dd class="fact-val">{study.data.company}</dd>
                  </div>
                )}
                {study.data.role && (
                  <div class="fact-item">
                    <dt class="fact-key">Role:</dt>
                    <dd class="fact-val">{study.data.role}</dd>
                  </div>
                )}
                {study.data.timeframe && (
                  <div class="fact-item">
                    <dt class="fact-key">Timeframe:</dt>
                    <dd class="fact-val">{study.data.timeframe}</dd>
                  </div>
                )}
              </dl>
            </div>
          )
        }

        {
          study.data.technologies && study.data.technologies.length > 0 && (
            <div class="tech-stack">
              <span class="meta-label">Technologies & Architecture:</span>
              <div class="tags-container">
                {study.data.technologies.map((tech) => (
                  <Tag>{tech}</Tag>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </Container>
  </Section>

  <!-- Markdown Content Section -->
  <Section class="content-section">
    <Container>
      <div class="markdown-body">
        <Content />
      </div>
    </Container>
  </Section>

  <!-- Footer Navigation & CTA -->
  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
    border-bottom: 1px solid var(--color-surface-elevated);
  }

  .breadcrumb {
    margin-bottom: var(--space-6, 24px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 8px);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small, 16px);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .back-icon {
    width: 18px;
    height: 18px;
  }

  .title {
    margin-bottom: var(--space-4, 16px);
  }

  .summary {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    line-height: 1.6;
    max-width: 800px;
    margin-bottom: var(--space-6, 24px);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
    margin-top: var(--space-6, 24px);
    padding-top: var(--space-6, 24px);
    border-top: 1px solid var(--color-surface-elevated);
  }

  @media (min-width: 768px) {
    .meta-grid {
      grid-template-columns: auto 1fr;
      gap: var(--space-8, 32px);
      align-items: start;
    }
  }

  .meta-label {
    font-size: var(--font-size-caption, 14px);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .quick-facts-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 12px);
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-elevated);
    border-radius: 8px;
    padding: var(--space-4, 16px);
    min-width: 260px;
  }

  .facts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 8px);
    margin: 0;
  }

  .fact-item {
    display: flex;
    gap: var(--space-2, 8px);
    font-size: var(--font-size-small, 16px);
  }

  .fact-key {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .fact-val {
    color: var(--color-text-primary);
    font-weight: 500;
    margin: 0;
  }

  .tech-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 12px);
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 8px);
  }

  .content-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-16, 64px);
  }

  .markdown-body {
    max-width: 860px;
    margin: 0 auto;
    color: var(--color-text-secondary);
    font-size: var(--font-size-body, 18px);
    line-height: 1.7;
  }

  .markdown-body :global(h2) {
    color: var(--color-text-primary);
    font-size: var(--font-size-h2, 40px);
    font-weight: 700;
    margin-top: var(--space-24, 96px);
    margin-bottom: var(--space-6, 24px);
    padding-top: var(--space-8, 32px);
    border-top: 1px solid var(--color-surface-elevated);
  }

  .markdown-body :global(h2:first-of-type) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .markdown-body :global(h3) {
    color: var(--color-text-primary);
    font-size: var(--font-size-h4, 24px);
    font-weight: 600;
    margin-top: var(--space-8, 32px);
    margin-bottom: var(--space-4, 16px);
  }

  .markdown-body :global(p) {
    margin-bottom: var(--space-6, 24px);
  }

  .markdown-body :global(strong) {
    color: var(--color-text-primary);
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    margin-bottom: var(--space-6, 24px);
    padding-left: var(--space-6, 24px);
  }

  .markdown-body :global(li) {
    margin-bottom: var(--space-2, 8px);
  }

  @media (max-width: 768px) {
    .header-section {
      padding-top: var(--space-8, 32px);
      padding-bottom: var(--space-6, 24px);
    }

    .summary {
      font-size: var(--font-size-small, 16px);
      line-height: 1.5;
      margin-bottom: var(--space-4, 16px);
    }

    .meta-grid {
      margin-top: var(--space-4, 16px);
      padding-top: var(--space-4, 16px);
      gap: var(--space-4, 16px);
    }

    .quick-facts-card {
      min-width: 100%;
      padding: var(--space-3, 12px) var(--space-4, 16px);
    }

    .content-section {
      padding-top: var(--space-6, 24px);
      padding-bottom: var(--space-12, 48px);
    }

    .markdown-body {
      font-size: var(--font-size-small, 16px);
      line-height: 1.65;
    }

    .markdown-body :global(h2) {
      font-size: clamp(1.4rem, 5.5vw, 1.75rem);
      margin-top: var(--space-8, 32px);
      margin-bottom: var(--space-3, 12px);
      padding-top: var(--space-6, 24px);
    }

    .markdown-body :global(h3) {
      font-size: clamp(1.15rem, 4.5vw, 1.35rem);
      margin-top: var(--space-6, 24px);
      margin-bottom: var(--space-2, 8px);
    }

    .markdown-body :global(p) {
      margin-bottom: var(--space-4, 16px);
    }

    .markdown-body :global(ul),
    .markdown-body :global(ol) {
      margin-bottom: var(--space-4, 16px);
      padding-left: var(--space-4, 16px);
    }
  }
</style>
