---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Heading from '../components/Heading.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="About Me — Brayan Mercado | Full Stack Software Engineer"
  description="Full Stack Software Engineer focused on product development, software architecture, and applied AI."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>About Me</Heading>
      <p class="page-subtitle">
        Full Stack Software Engineer focused on product development, software architecture, and applied AI.
      </p>
    </Container>
  </Section>

  <Section class="content-section">
    <Container>
      <div class="about-grid">
        <article class="about-prose">
          <p>
            I didn't start out building software. I started as a food engineer, learning to model processes, control quality, and solve problems with structure and analysis — long before I touched a line of TypeScript.
          </p>

          <p>
            That changed when I moved into software: first building interfaces, then backend systems, and eventually taking on architecture decisions end to end. At Belvi Digital I worked on Zeus, an IoT platform for medical aesthetic devices, and PLEI, an e-learning platform — starting on the frontend and growing into backend and full-stack responsibilities. At Alaska Tech, the company I co-founded, I designed the backend of VeciApp, a marketplace connecting local merchants with their community.
          </p>

          <blockquote class="pull-quote">
            "I stopped treating AI as a plugin and started treating it as a system."
          </blockquote>

          <p>
            The same principle now guides my work: understand the product and the problem first, then choose the architecture that fits it.
          </p>
        </article>

        <aside class="quick-facts-panel">
          <div class="profile-image-wrapper">
            <img src="/bram-profile.webp" alt="Portrait of Brayan Mercado" class="profile-image" />
          </div>
          <h3 class="facts-title">Quick facts</h3>
          <dl class="facts-list">
            <div class="fact-item">
              <dt class="fact-label">Focus</dt>
              <dd class="fact-value">Full Stack, Backend, Applied AI, Software Architecture</dd>
            </div>
            <div class="fact-item">
              <dt class="fact-label">Ecosystem</dt>
              <dd class="fact-value">TypeScript</dd>
            </div>
            <div class="fact-item">
              <dt class="fact-label">Currently</dt>
              <dd class="fact-value">Co-Founder & Full Stack Software Engineer at Alaska Tech</dd>
            </div>
            <div class="fact-item">
              <dt class="fact-label">Background</dt>
              <dd class="fact-value">Food Engineering → Software Engineering</dd>
            </div>
          </dl>
        </aside>
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
    border-bottom: 1px solid var(--color-surface-elevated);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .content-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-16, 64px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12, 48px);
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 340px;
      gap: var(--space-16, 64px);
      align-items: start;
    }
  }

  .about-prose {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    line-height: 1.75;
  }

  .about-prose p {
    margin-bottom: var(--space-8, 32px);
  }

  .about-prose p:last-child {
    margin-bottom: 0;
  }

  .pull-quote {
    margin: var(--space-8, 32px) 0;
    padding: var(--space-6, 24px) var(--space-8, 32px);
    border-left: 4px solid var(--color-primary);
    background-color: var(--color-surface);
    border-radius: 0 8px 8px 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-h3, 28px);
    font-weight: 600;
    line-height: 1.4;
  }

  .quick-facts-panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-surface-elevated);
    border-radius: 12px;
    padding: var(--space-6, 24px);
  }

  .profile-image-wrapper {
    margin-bottom: var(--space-6, 24px);
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts-title {
    color: var(--color-text-primary);
    font-size: var(--font-size-h4, 20px);
    font-weight: 600;
    margin-bottom: var(--space-4, 16px);
    padding-bottom: var(--space-3, 12px);
    border-bottom: 1px solid var(--color-surface-elevated);
  }

  .facts-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 16px);
    margin: 0;
  }

  .fact-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact-label {
    color: var(--color-text-muted);
    font-size: var(--font-size-caption, 14px);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .fact-value {
    color: var(--color-text-primary);
    font-size: var(--font-size-small, 16px);
    font-weight: 500;
    margin: 0;
    line-height: 1.5;
  }
</style>
