---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTASection from '../../components/CTASection.astro';

const products = await getCollection('products');

// Filter products for EN
const enProducts = products
  .filter((p) => p.id.startsWith('en/'))
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
---

<Layout
  title="Products — Brayan Mercado | Software Engineer"
  description="Products and software projects developed around specific problems."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Products</Heading>
      <p class="page-subtitle">
        Products and software projects developed around specific problems.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="products-grid horizontal-scroll-mobile">
        {
          enProducts.map((product) => (
            <a href={`/products/${product.data.slug}`} class="product-link">
              <ProductCard
                title={product.data.title}
                tagline={product.data.tagline}
                status={product.data.status}
                link={product.data.website}
              />
            </a>
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .product-link {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }
</style>
