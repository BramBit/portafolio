---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTASection from '../../components/CTASection.astro';

const articles = await getCollection('engineering');

// Filter articles for EN
const enArticles = articles
  .filter((a) => a.id.startsWith('en/'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout
  title="Engineering — Brayan Mercado | Software Engineer"
  description="Technical articles about software architecture, applied AI, search systems, and implementation decisions from real projects."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Engineering</Heading>
      <p class="page-subtitle">
        Technical articles about software architecture, applied AI, search systems, and implementation decisions from real projects.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="articles-grid horizontal-scroll-mobile">
        {
          enArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              readingTime={article.data.readingTime}
              tags={article.data.tags}
              slug={article.data.slug}
              href={`/engineering/${article.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="Have a project in development?"
    description="Tell me what you're building and we can review where I can contribute."
    button={{ label: "Let's talk", href: '/contact', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
