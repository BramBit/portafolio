---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectFeature from '../../components/ProjectFeature.astro';
import ExperienceGroups from '../../components/ExperienceGroups.astro';
import StackGroups from '../../components/StackGroups.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import Button from '../../components/Button.astro';
import { getExperienceGroups } from '../../data/experience';
import { buildStackGroups } from '../../data/stack';
import { servicesES } from '../../data/services';
import { siteConfig } from '../../data/site';

const byNewest = <T extends { data: { publishedAt: Date } }>(a: T, b: T) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime();

// Experience: every case study of this language, grouped by company
const caseStudies = (await getCollection('case-studies'))
  .filter((c) => c.id.startsWith('es/'))
  .sort(byNewest);

const experienceGroups = getExperienceGroups(caseStudies, 'es');

const productOrder = ['product-checkout-platform', 'pliegos'];
const products = (await getCollection('products'))
  .filter((p) => p.id.startsWith('es/'))
  .sort((a, b) => {
    const idxA = productOrder.indexOf(a.data.slug);
    const idxB = productOrder.indexOf(b.data.slug);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    return (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0);
  });

// Stack: documented case studies, services, and product technologies
const stackGroups = buildStackGroups({
  lang: 'es',
  cases: caseStudies.map((study) => ({ slug: study.data.slug, technologies: study.data.technologies })),
  services: servicesES.map((service) => ({ slug: service.id, technologies: service.technologies })),
});

// Verified contact channels (src/data/site.ts)
const contacts = [
  { label: 'Correo', value: siteConfig.email, href: `mailto:${siteConfig.email}` },
  { label: 'LinkedIn', value: 'brayan-mercado-sanmartin', href: siteConfig.social.linkedin, external: true },
  { label: 'GitHub', value: 'BramBit', href: siteConfig.social.github, external: true },
];
---

<Layout
  title="Brayan Mercado — Ingeniero de Software Full Stack"
  description="Diseño y construyo funcionalidades Full Stack, sistemas Backend y capacidades de IA aplicada para productos reales."
>
  <!-- Hero Section (Section 4 ES) -->
  <Hero
    title="Construyo software de punta a punta: interfaces, APIs, arquitectura e IA aplicada."
    subtitle="Brayan Mercado — Ingeniero de Software Full Stack"
    description="Desarrollo funcionalidades Full Stack y sistemas de backend, integrando interfaz, APIs, datos e IA dentro de una misma solución."
    primaryButton={{ label: 'Ver el trabajo', href: '/es/casos-de-exito' }}
    secondaryButton={{ label: 'Hablemos de tu proyecto', href: '/es/contacto' }}
    meta={[
      { label: 'Actualmente', value: 'Co-fundador y Full Stack Software Engineer en Alaska Tech' },
      { label: 'Ecosistema', value: 'TypeScript' },
      { label: 'Foco', value: 'Full Stack, Backend, IA Aplicada, Arquitectura de Software' },
    ]}
  />

  <!-- 01 Products: the featured project leads the page -->
  <Section id="products">
    <Container>
      <SectionHeader
        index="01"
        title="Productos"
        href="/es/productos"
        linkLabel="Ver todos los productos"
      />
      <div class="feature-list">
        {
          products.map((product, i) => (
            <ProjectFeature
              title={product.data.title}
              tagline={product.data.tagline}
              status={product.data.status}
              problem={product.data.problem}
              solution={product.data.solution}
              href={`/es/productos/${product.data.slug}`}
              website={product.data.website}
              reverse={i % 2 === 1}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 02 Experience: grouped by company, every case study included -->
  <Section id="case-studies">
    <Container>
      <SectionHeader
        index="02"
        title="Experiencia"
        href="/es/casos-de-exito"
        linkLabel="Ver toda la experiencia"
      />
      <ExperienceGroups groups={experienceGroups} lang="es" />
    </Container>
  </Section>

  <!-- 03 Services -->
  <Section id="services">
    <Container>
      <SectionHeader
        index="03"
        title="Servicios"
        href="/es/servicios"
        linkLabel="Ver todos los servicios"
        description="Cada solución parte del problema que necesitas resolver. La tecnología se elige en función del objetivo, el alcance y las necesidades reales."
      />
      <div class="grid-two-cols">
        {
          servicesES.map((service) => (
            <ServiceCard service={service} />
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- 04 Tech stack -->
  <Section id="stack">
    <Container>
      <SectionHeader index="04" title="Stack técnico" description="Tecnologías documentadas en casos de estudio, productos y servicios, organizadas por capa." />
      <StackGroups groups={stackGroups} />
    </Container>
  </Section>

  <!-- About Preview Section (Section 16 ES) -->
  <Section id="about-preview">
    <Container>
      <div class="about-box" data-reveal>
        <div class="about-content">
          <SectionHeader index="05" title="Sobre mí" />
          <p class="about-text">
            No empecé construyendo software. Empecé como ingeniero de alimentos, aprendiendo a modelar procesos, controlar calidad y resolver problemas con análisis y estructura — mucho antes de tocar una línea de TypeScript.
          </p>
          <p class="about-text">
            Eso cambió cuando entré al desarrollo de software: primero construyendo interfaces, después sistemas backend, y con el tiempo asumiendo decisiones de arquitectura de punta a punta...
          </p>
          <div class="about-action">
            <Button variant="secondary" href="/es/sobre-mi">Leer más →</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <CTASection
    title="¿Tienes un proyecto en desarrollo?"
    description="Cuéntame qué estás construyendo y revisamos dónde puedo aportar."
    button={{ label: 'Hablemos', href: '/es/contacto', variant: 'primary' }}
    contacts={contacts}
  />
</Layout>

<style>
  :global(#stack) { padding-bottom: var(--space-64); }
  :global(#about-preview) { padding-top: var(--space-64); }

  .feature-list {
    display: grid;
    gap: var(--space-32);
  }

  .grid-two-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-24);
  }

  @media (min-width: 768px) {
    .grid-two-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .about-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-32);
  }

  .about-content {
    max-width: 800px;
  }

  .about-text {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg);
    line-height: 1.6;
    margin-top: var(--space-16);
    margin-bottom: var(--space-16);
  }

  .about-action {
    display: flex;
    margin-top: var(--space-24);
  }
</style>
