---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { servicesES } from '../../data/services';
---

<Layout
  title="Servicios de Ingeniería de Software — Brayan Mercado"
  description="Desarrollo de software a la medida, automatización, inteligencia artificial aplicada y evolución de plataformas existentes adaptadas a tus procesos de negocio."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Servicios de Ingeniería de Software</Heading>
      <p class="page-subtitle">
        Desarrollo de software a la medida, automatización, inteligencia artificial aplicada y evolución de plataformas existentes adaptadas a tus procesos de negocio.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <h2 class="visually-hidden">Todos los servicios</h2>
      <div class="services-grid">
        {
          servicesES.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="¿Tienes un proyecto en desarrollo?"
    description="Cuéntame qué estás construyendo y revisamos dónde puedo aportar."
    button={{ label: 'Hablemos', href: '/es/contacto', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8, 32px);
    }
  }
</style>
