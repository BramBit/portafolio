---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Heading from '../../components/Heading.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';

// Section 6 ES - oferta de servicios enfocada
const servicesES = [
  {
    title: 'Sistemas de Inteligencia Artificial',
    description: 'Diseño e implementación de sistemas RAG, búsqueda semántica e integraciones con LLMs, integrados a aplicaciones existentes, desde la arquitectura hasta producción.',
    technologies: ['RAG', 'Embeddings', 'pgvector', 'OpenAI'],
  },
  {
    title: 'Backend & Full Stack',
    description: 'Desarrollo de funcionalidades de punta a punta y servicios backend: modelado de datos, lógica de negocio, APIs REST y la interfaz, aplicando patrones de arquitectura donde resuelven un problema real del producto.',
    technologies: ['TypeScript', 'Node.js', 'PostgreSQL', 'React', 'Next.js'],
  },
];
---

<Layout
  title="Servicios de Ingeniería de Software — Brayan Mercado"
  description="Desarrollo Full Stack, ingeniería Backend, arquitectura e integración de inteligencia artificial para productos digitales."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Servicios de Ingeniería de Software</Heading>
      <p class="page-subtitle">
        Desarrollo Full Stack, ingeniería Backend, arquitectura e integración de inteligencia artificial para productos digitales.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="services-grid horizontal-scroll-mobile">
        {
          servicesES.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              technologies={service.technologies}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="¿Tienes un proyecto en desarrollo?"
    description="Cuéntame qué estás construyendo y revisamos dónde puedo aportar."
    button={{ label: 'Hablemos', href: '/es/contacto', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8, 32px);
    }
  }
</style>
