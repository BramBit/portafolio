---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Section from '../../../components/Section.astro';
import Container from '../../../components/Container.astro';
import Heading from '../../../components/Heading.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import CTASection from '../../../components/CTASection.astro';

const articles = await getCollection('engineering');

// Filter articles for ES
const esArticles = articles
  .filter((a) => a.id.startsWith('es/'))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<Layout
  title="Ingeniería — Brayan Mercado | Software Engineer"
  description="Artículos técnicos sobre arquitectura de software, IA aplicada, sistemas de búsqueda y decisiones de implementación tomadas en proyectos reales."
>
  <Section class="page-header-section">
    <Container>
      <Heading level={1}>Ingeniería</Heading>
      <p class="page-subtitle">
        Artículos técnicos sobre arquitectura de software, IA aplicada, sistemas de búsqueda y decisiones de implementación tomadas en proyectos reales.
      </p>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="articles-grid horizontal-scroll-mobile">
        {
          esArticles.map((article) => (
            <ArticleCard
              title={article.data.title}
              excerpt={article.data.excerpt}
              readingTime={article.data.readingTime}
              tags={article.data.tags}
              slug={article.data.slug}
              href={`/es/ingenieria/${article.data.slug}`}
            />
          ))
        }
      </div>
    </Container>
  </Section>

  <CTASection
    title="¿Tienes un proyecto en desarrollo?"
    description="Cuéntame qué estás construyendo y revisamos dónde puedo aportar."
    button={{ label: 'Hablemos', href: '/es/contacto', variant: 'primary' }}
  />
</Layout>

<style>
  .page-header-section {
    padding-top: var(--space-12, 48px);
    padding-bottom: var(--space-8, 32px);
  }

  .page-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--font-size-body-lg, 20px);
    margin-top: var(--space-4, 16px);
    max-width: 720px;
    line-height: 1.6;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 24px);
  }

  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
