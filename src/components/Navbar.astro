---
import Container from './Container.astro';
import MobileMenu from './MobileMenu.astro';
import styles from './Navbar.module.css';
import { getLangFromUrl, getNavItems, getEquivalentRoute } from '../i18n';

interface Props {
  currentPath?: string;
  class?: string;
}

const { currentPath = Astro.url.pathname, class: className = '' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const navItems = getNavItems(lang);

const isActive = (href: string) => {
  if (href === '/' || href === '/es/') {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
};

const logoHref = lang === 'es' ? '/es/' : '/';
const enRoute = getEquivalentRoute(currentPath, 'en');
const esRoute = getEquivalentRoute(currentPath, 'es');
---

<header class:list={[styles.header, className]}>
  <Container class={styles.navContainer}>
    <a href={logoHref} class={styles.logoBadge} aria-label="Brayan Mercado - Home">
      <img src="/logo.svg" alt="BM Logo" class={styles.logoImage} />
    </a>

    <nav class={styles.nav} aria-label="Main Navigation">
      <ul class={styles.navLinks}>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  styles.navLink,
                  { [styles.active]: isActive(item.href) }
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class={styles.langSwitcher}>
          {
            lang === 'en' ? (
              <>
                <span class={styles.langActive}>EN</span>
                <span>/</span>
                <a href={esRoute} class={styles.langLink}>ES</a>
              </>
            ) : (
              <>
                <a href={enRoute} class={styles.langLink}>EN</a>
                <span>/</span>
                <span class={styles.langActive}>ES</span>
              </>
            )
          }
        </li>
      </ul>
    </nav>

    <MobileMenu currentPath={currentPath} />
  </Container>
</header>
