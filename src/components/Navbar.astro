---
import Container from './Container.astro';
import MobileMenu from './MobileMenu.astro';
import styles from './Navbar.module.css';
import { getLangFromUrl, getNavItems, getEquivalentRoute } from '../i18n';

interface Props {
  currentPath?: string;
  class?: string;
}

const { currentPath = Astro.url.pathname, class: className = '' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const navItems = getNavItems(lang);

const isActive = (href: string) => {
  if (href === '/' || href === '/es/') {
    return currentPath === href;
  }
  return currentPath.startsWith(href);
};

const logoHref = lang === 'es' ? '/es/' : '/';
const enRoute = getEquivalentRoute(currentPath, 'en');
const esRoute = getEquivalentRoute(currentPath, 'es');
const navLabel = lang === 'es' ? 'Navegación principal' : 'Main navigation';
---

<header class:list={[styles.header, className]}>
  <Container class={styles.navContainer}>
    <a href={logoHref} class={styles.logoBadge} aria-label="Brayan Mercado - Home">
      <img src="/logo.svg" alt="BM Logo" width="50" height="50" class={styles.logoImage} />
    </a>

    <nav class={styles.nav} aria-label={navLabel}>
      <ul class={styles.navLinks}>
        {
          navItems.map((item) => {
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[styles.navLink, { [styles.active]: active }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li class={styles.langSwitcher}>
          {
            lang === 'en' ? (
              <>
                <span class={styles.langActive} aria-current="true">EN</span>
                <span aria-hidden="true">/</span>
                <a href={esRoute} class={styles.langLink} lang="es" hreflang="es">ES</a>
              </>
            ) : (
              <>
                <a href={enRoute} class={styles.langLink} lang="en" hreflang="en">EN</a>
                <span aria-hidden="true">/</span>
                <span class={styles.langActive} aria-current="true">ES</span>
              </>
            )
          }
        </li>
      </ul>
    </nav>

    <MobileMenu currentPath={currentPath} />
  </Container>
</header>
