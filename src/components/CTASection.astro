---
import Section from './Section.astro';
import Container from './Container.astro';
import Button from './Button.astro';
import styles from './CTASection.module.css';

interface ButtonConfig {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary';
  [key: string]: any;
}

interface ContactLink {
  label: string;
  value: string;
  href: string;
  external?: boolean;
}

interface Props {
  title: string;
  description?: string;
  button: ButtonConfig;
  /** Verified contact channels shown beside the call to action */
  contacts?: ContactLink[];
  class?: string;
}

const { title, description, button, contacts = [], class: className = '' } = Astro.props;
const { label: buttonLabel, variant = 'primary', ...buttonRest } = button;
---

<Section class={className}>
  <Container>
    <div class:list={[styles.cta, { [styles.withContacts]: contacts.length > 0 }]} data-reveal>
      <div class={styles.copy}>
        <h2 class={styles.title}>{title}</h2>
        {description && <p class={styles.description}>{description}</p>}
        <div class={styles.action}>
          <Button variant={variant} {...buttonRest}>
            {buttonLabel}
            <span class={styles.arrow} aria-hidden="true">→</span>
          </Button>
        </div>
      </div>

      {
        contacts.length > 0 && (
          <ul class={styles.contacts}>
            {contacts.map((contact) => (
              <li>
                <a
                  href={contact.href}
                  class={styles.contact}
                  target={contact.external ? '_blank' : undefined}
                  rel={contact.external ? 'noopener noreferrer' : undefined}
                >
                  <span class="label">{contact.label}</span>
                  <span class={styles.value}>{contact.value}</span>
                  <span class={styles.contactArrow} aria-hidden="true">{contact.external ? '↗' : '→'}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Container>
</Section>
