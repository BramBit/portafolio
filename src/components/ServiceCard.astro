---
import Card from './Card.astro';
import styles from './ServiceCard.module.css';

interface Props {
  title: string;
  description: string;
  technologies?: string[];
  interactive?: boolean;
  class?: string;
}

const {
  title,
  description,
  technologies = [],
  interactive = false,
  class: className = '',
} = Astro.props;
---

<Card interactive={interactive} class:list={[styles.serviceCard, className]}>
  <h3 class={styles.title}>{title}</h3>
  <p class={styles.description}>{description}</p>

  {
    technologies.length > 0 && (
      <div class={styles.techFooter}>
        <span class={styles.techLabel}>Tech Stack:</span>
        <span class={styles.techList}>{technologies.join(' · ')}</span>
      </div>
    )
  }
</Card>
