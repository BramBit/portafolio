---
import Container from './Container.astro';
import { siteConfig } from '../data/site';
import styles from './Footer.module.css';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={[styles.footer, className]}>
  <Container class={styles.content}>
    <div class={styles.topRow}>
      <div class={styles.brand}>
        <a href="/" class={styles.logoBadge} aria-label="Brayan Mercado - Home">
          BM
        </a>
        <div class={styles.brandText}>
          <span class={styles.name}>{siteConfig.name}</span>
          <span class={styles.role}>{siteConfig.role}</span>
        </div>
      </div>

      <ul class={styles.socialLinks}>
        <li>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialLink}
            aria-label="LinkedIn Profile"
          >
            <svg class={styles.icon} viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"
              ></path>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class={styles.socialLink}
            aria-label="GitHub Profile"
          >
            <svg class={styles.icon} viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              ></path>
            </svg>
            GitHub
          </a>
        </li>
      </ul>
    </div>

    <div class={styles.bottomRow}>
      <p class={styles.copyright}>
        &copy; {currentYear} Brayan Mercado. All rights reserved.
      </p>
      <p class={styles.tagline}>{siteConfig.tagline}</p>
    </div>
  </Container>
</footer>
