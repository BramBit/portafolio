    flow: 'M77 80V92M77 144V156M77 208V220M77 272V284M243 80V92M243 144V156M243 208V220M243 272V284M77 336V348H160V118H174',
  },
  plei: {
    height: 332,
    nodes: [[8,24,138,52,'node'],[8,96,138,52,'node'],[8,168,138,52,'node'],[175,220,130,48,'accent']],
