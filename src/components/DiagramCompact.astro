  },
  'applied-ai': {
    width: 280, height: 350,
    nodes: [[8,14,124,56,'document'],[148,14,124,56,'module'],[148,102,124,56,'indexBox'],[8,190,124,56,'query'],[148,190,124,56,'retrieval'],[148,278,124,56,'context'],[8,278,124,56,'response']],
    labels: [[70,42,0],[210,42,1],[210,130,2],[70,218,3],[210,218,4],[210,306,5],[70,306,6]],
    flow: 'M132 42H148M210 70V102M210 158V190M132 218H148M210 246V278M148 306H132',
