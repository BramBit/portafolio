};
// Homepage previews retain the same nodes with shorter connectors and local spacing.
const previewLayouts: Record<string, Layout> = {
  'custom-software': {
    width: 280, height: 246,
    nodes: [[8,18,120,52,'module'],[152,18,120,52,'module'],[46,100,188,60,'core'],[70,196,140,40,'module']],
    labels: [[68,44,0],[212,44,1],[140,130,2],[140,216,3]],
    flow: 'M68 70V84H95V100M212 70V84H185V100M140 160V196',
  },
  automation: {
    width: 280, height: 324,
    nodes: [[8,16,124,58,'module'],[8,112,124,58,'core'],[148,114,124,54,'destination'],[148,184,124,54,'destination'],[148,254,124,54,'destination']],
