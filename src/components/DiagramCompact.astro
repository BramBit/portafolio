  },
  maleua: {
    height: 230,
    nodes: [[8,20,138,64,'node'],[174,20,138,64,'accent'],[174,150,138,64,'node'],[8,150,138,64,'accent']],
    labels: [[77,52,0],[243,52,1],[243,182,2],[77,182,3]],
    flow: 'M146 52H174M243 84V150M174 182H146',
  },
};
const baseLayout = preview ? previewLayouts[kind] : layouts[kind];
const layout: Layout = detail && kind === 'plei' ? {
  ...baseLayout,
  flow: 'M146 56H240M146 136H170M146 216H240M240 216V250',
  nodes: baseLayout.nodes.map((node, index) => index === 3 ? [175,250,130,60,'accent'] : node),
  labels: baseLayout.labels.map((label, index) => index === 3 || index === 4 ? [240,label[1],label[2]] : label),
} : baseLayout;
const compactLines = (index: number) => {
  if (preview && kind === 'plei' && index === 2 && lang === 'en') return ['Title', 'Matching'];
  if (kind === 'applied-ai' && index === 4 && lang === 'es') return ['Recuperar'];
  if (kind === 'modernization') {
    if (index === 1) return lang === 'es' ? ['Arquitectura', 'modular'] : ['Modular', 'Architecture'];
    if (index >= 2 && index <= 5) return labels[index][0].split(' ');
    if (index === 6) return lang === 'es' ? ['Validación', 'automatizada'] : ['Automated', 'Validation'];
    if (index === 7) return lang === 'es' ? ['Sistema', 'evolucionado'] : ['Evolved', 'System'];
  }
  if (kind === 'plei' && index === 5) return preview
    ? lang === 'es' ? ['Acceso: rol / jerarquía', '/ marca'] : ['Access: role / hierarchy', '/ brand']
    : lang === 'es' ? ['Acceso: rol / jerarquía / marca'] : ['Access: role / hierarchy / brand'];
  return labels[index];
};
---
<svg class={preview ? 'diagram-preview' : 'diagram-compact'} viewBox={`0 0 ${layout.width ?? 320} ${layout.height}`} aria-hidden="true" focusable="false" data-diagram-layout={preview ? 'preview' : 'compact'} style={preview ? `--diagram-node-font-size: ${layout.width === 280 ? 18 : 20}px; --diagram-indicator-font-size: 18px;` : undefined}>
  {kind === 'plei' && <rect class={classes.accessBoundary} x="4" y="10" width="312" height={preview ? 264 : 308} rx="8" />}
  <path class={classes.flow} d={layout.flow} />
  {layout.nodes.map(([x,y,width,height,style]) => <rect class={classes[style]} x={x} y={y} width={width} height={height} rx="5" />)}
  {kind === 'automation' && <path class={classes.event} d={preview ? 'm210 23 22 22-22 22-22-22z' : 'm210 35 22 22-22 22-22-22z'} />}
  {kind === 'plei' && <path class={classes.accent} d={preview ? 'm240 42 76 80-76 80-76-80z' : detail ? 'm240 56 70 80-70 80-70-80z' : 'm247 70 65 66-65 66-65-66z'} />}
  {kind === 'modernization' && <>
    <path class={classes.legacyLines} d={preview ? 'M20 100l66 80M86 100l-66 80' : 'M20 106l66 88M86 106l-66 88'} opacity=".25" />
    <path class={classes.arrow} d={preview ? 'm100 130 10 10-10 10' : 'm100 140 10 10-10 10'} />
    <path class={classes.validation} d={preview ? 'M116 210H272M130 210l8 8 15-17M222 210l8 8 15-17' : 'M116 254H272M130 254l8 8 15-17M222 254l8 8 15-17'} />
  </>}
  {kind === 'zeus' && <>
    <text x="8" y={preview ? 22 : 18} fill="var(--color-accent)" font-family="var(--font-family-mono)" font-size="var(--diagram-indicator-font-size, calc(15px - var(--diagram-label-reduction, 0px)))">{lang === 'es' ? 'INGESTA ↓' : 'INGESTION ↓'}</text>
    <text x="174" y={preview ? 22 : 18} fill="var(--color-accent)" font-family="var(--font-family-mono)" font-size="var(--diagram-indicator-font-size, calc(15px - var(--diagram-label-reduction, 0px)))">{lang === 'es' ? 'CONSULTA ↓' : 'QUERY ↓'}</text>
  </>}
  {layout.labels.map(([x,y,index,size]) => <DiagramLabel centered={preview} node={!(kind === 'plei' && index === 5)} x={x} y={y} lines={compactLines(index)} size={size ?? 18} />)}
</svg>
