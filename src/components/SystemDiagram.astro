---
import type { CaseSlug, ExperienceLang } from '../data/experience';
import DiagramFrame from './DiagramFrame.astro';
import DiagramCompact from './DiagramCompact.astro';
import DiagramLabel from './DiagramLabel.astro';
import styles from './SystemDiagram.module.css';
interface Props { slug: CaseSlug; lang: ExperienceLang; compact?: boolean; detail?: boolean; labelReduction?: number; nodeFontSize?: number; indicatorFontSize?: number; visibleFontSize?: number; }
const { slug, lang, compact = false, detail = false, labelReduction = 0, nodeFontSize, indicatorFontSize, visibleFontSize } = Astro.props;
// Detail diagrams have their own readable screen size, independent of the portfolio grids.
const detailFontSize: Record<CaseSlug, number> = { zeus: 15, plei: 14, veciapp: 15, maleua: 15 };
const text = {
  en: {
    zeus: { caption: 'Documents become retrievable context; questions use that context through a model adapter.', parts: ['Ingestion: documents and SHA-256, extraction, chunking, embeddings, PostgreSQL / pgvector', 'Query: question, retrieval from the vector store, context, LLM adapter, response'] },
    plei: { caption: 'Vector, full-text, and title results converge through weighted RRF with access restrictions.', parts: ['Vector search', 'Full-text search', 'Title matches (ILIKE)', 'Weighted RRF', 'Authorized results'] },
    veciapp: { caption: 'API capabilities connect clients, spatial data, administration, and payments.', parts: ['Client and admin panel', 'Express API', 'PostgreSQL / PostGIS', 'Wompi payment flow'] },
    maleua: { caption: 'Structured content and Astro components produce static assets for publication.', parts: ['Structured content', 'Astro components', 'Static HTML / CSS', 'Vercel publication'] },
  },
  es: {
    zeus: { caption: 'Los documentos se convierten en contexto recuperable; la pregunta lo usa mediante un adaptador de modelo.', parts: ['Ingesta: documentos y SHA-256, extracción, fragmentación, embeddings, PostgreSQL / pgvector', 'Consulta: pregunta, recuperación desde el almacén vectorial, contexto, adaptador LLM, respuesta'] },
    plei: { caption: 'Resultados vectoriales, full-text y por título convergen en RRF ponderado con restricciones de acceso.', parts: ['Búsqueda vectorial', 'Búsqueda full-text', 'Títulos (ILIKE)', 'RRF ponderado', 'Resultados autorizados'] },
    veciapp: { caption: 'Las capacidades de la API conectan clientes, datos espaciales, administración y pagos.', parts: ['Cliente y panel', 'API Express', 'PostgreSQL / PostGIS', 'Flujo de pago Wompi'] },
    maleua: { caption: 'El contenido estructurado y los componentes Astro producen archivos estáticos para publicar.', parts: ['Contenido estructurado', 'Componentes Astro', 'HTML / CSS estático', 'Publicación Vercel'] },
  },
} as const;
const info = text[lang][slug];
const labelsByKind: Record<string, string[][]> = {
  'zeus': [
    lang === 'es' ? ['Documentos', 'SHA-256'] : ['Documents', 'SHA-256'],
    lang === 'es' ? ['Extracción'] : ['Extraction'],
    lang === 'es' ? ['Fragmentos'] : ['Chunking'],
    lang === 'es' ? ['Embeddings'] : ['Embeddings'],
    lang === 'es' ? ['PostgreSQL', '/ pgvector'] : ['PostgreSQL', '/ pgvector'],
    lang === 'es' ? ['Pregunta'] : ['Question'],
    lang === 'es' ? ['Recuperar'] : ['Retrieval'],
    lang === 'es' ? ['Contexto'] : ['Context'],
    lang === 'es' ? ['Adaptador', 'LLM'] : ['LLM', 'Adapter'],
    lang === 'es' ? ['Respuesta'] : ['Response'],
  ],
  'plei': [
    lang === 'es' ? ['Búsqueda', 'vectorial'] : ['Vector', 'Search'],
    lang === 'es' ? ['Full-text'] : ['Full-text'],
    lang === 'es' ? ['Títulos / ILIKE'] : ['Title Matching'],
    lang === 'es' ? ['RRF', 'ponderado'] : ['Weighted', 'RRF'],
    lang === 'es' ? ['Resultados'] : ['Results'],
    lang === 'es' ? ['Restricciones de acceso · rol / jerarquía / marca'] : ['Access restrictions · role / hierarchy / brand'],
  ],
  'veciapp': [
    lang === 'es' ? ['Cliente'] : ['Client'],
    lang === 'es' ? ['Panel admin.'] : ['Admin Panel'],
    lang === 'es' ? ['API', 'Express'] : ['Express', 'API'],
    lang === 'es' ? ['PostgreSQL', '/ PostGIS'] : ['PostgreSQL', '/ PostGIS'],
    lang === 'es' ? ['Wompi'] : ['Wompi'],
  ],
  'maleua': [
    lang === 'es' ? ['Contenido', 'estructurado'] : ['Structured', 'Content'],
    lang === 'es' ? ['Componentes', 'Astro'] : ['Astro', 'Components'],
    lang === 'es' ? ['Generación', 'estática'] : ['Static', 'Generation'],
    lang === 'es' ? ['Vercel'] : ['Vercel'],
  ],
};

---
<figure class:list={[styles.diagram, compact && styles.compact]} data-system={slug} style={`--diagram-label-reduction: ${labelReduction}px;${nodeFontSize === undefined ? '' : ` --diagram-node-font-size: ${nodeFontSize}px;`}${indicatorFontSize === undefined ? '' : ` --diagram-indicator-font-size: ${indicatorFontSize}px;`}`}>
  <DiagramFrame preview={compact} visibleFontSize={detail ? detailFontSize[slug] : visibleFontSize} proportionalText={detail} caption={info.caption} parts={info.parts} lang={lang}>
  {compact && <DiagramCompact kind={slug} labels={labelsByKind[slug]} classes={styles} lang={lang} preview />}
  <DiagramCompact kind={slug} labels={labelsByKind[slug]} classes={styles} lang={lang} detail={detail} />
  {slug === 'zeus' && <svg class="diagram-wide" viewBox="-4 0 608 320" aria-hidden="true" focusable="false">
    <text x="10" y="22" fill="var(--color-accent)" font-size="var(--diagram-indicator-font-size, calc(18px - var(--diagram-label-reduction, 0px)))">{lang === 'es' ? 'INGESTA →' : 'INGESTION →'}</text>
    <text x="10" y="212" fill="var(--color-accent)" font-size="var(--diagram-indicator-font-size, calc(18px - var(--diagram-label-reduction, 0px)))">{lang === 'es' ? 'CONSULTA →' : 'QUERY →'}</text>
    <path class={styles.flow} d="M112 70H122M234 70H244M356 70H366M478 70H488M112 260H122M234 260H244M356 260H366M478 260H488M544 110V165H178V220" />
    <rect class={styles.node} x="0" y="30" width="112" height="80" rx="5" />
    <rect class={styles.accent} x="122" y="30" width="112" height="80" rx="5" />
    <rect class={styles.node} x="244" y="30" width="112" height="80" rx="5" />
    <rect class={styles.node} x="366" y="30" width="112" height="80" rx="5" />
    <rect class={styles.accent} x="488" y="30" width="112" height="80" rx="5" />
    <rect class={styles.node} x="0" y="220" width="112" height="80" rx="5" />
    <rect class={styles.accent} x="122" y="220" width="112" height="80" rx="5" />
    <rect class={styles.node} x="244" y="220" width="112" height="80" rx="5" />
    <rect class={styles.node} x="366" y="220" width="112" height="80" rx="5" />
    <rect class={styles.accent} x="488" y="220" width="112" height="80" rx="5" />
    <DiagramLabel size={17} x={56} y={70} lines={labelsByKind['zeus'][0]} />
    <DiagramLabel size={17} x={178} y={70} lines={labelsByKind['zeus'][1]} />
    <DiagramLabel size={17} x={300} y={70} lines={labelsByKind['zeus'][2]} />
    <DiagramLabel size={17} x={422} y={70} lines={labelsByKind['zeus'][3]} />
    <DiagramLabel size={17} x={544} y={70} lines={labelsByKind['zeus'][4]} />
    <DiagramLabel size={17} x={56} y={260} lines={labelsByKind['zeus'][5]} />
    <DiagramLabel size={17} x={178} y={260} lines={labelsByKind['zeus'][6]} />
    <DiagramLabel size={17} x={300} y={260} lines={labelsByKind['zeus'][7]} />
    <DiagramLabel size={17} x={422} y={260} lines={labelsByKind['zeus'][8]} />
    <DiagramLabel size={17} x={544} y={260} lines={labelsByKind['zeus'][9]} />
  </svg>}
  {slug === 'plei' && <svg class="diagram-wide" viewBox="0 0 600 300" aria-hidden="true" focusable="false">
    <rect class={styles.accessBoundary} x="22" y="10" width="566" height="241" rx="8" />
    <path class={styles.flow} d="M205 48H310V75M205 130H240M205 212H310V185M380 130H460" />
    <rect class={styles.node} x="35" y="20" width="170" height="57" rx="5" />
    <rect class={styles.node} x="35" y="101" width="170" height="57" rx="5" />
    <rect class={styles.node} x="35" y="183" width="170" height="57" rx="5" />
    <path class={styles.accent} d="m310 75 70 55-70 55-70-55z" />
    <rect class={styles.accent} x="460" y="101" width="115" height="58" rx="4" />

    <DiagramLabel x={120} y={48} lines={labelsByKind['plei'][0]} />
    <DiagramLabel x={120} y={130} lines={labelsByKind['plei'][1]} />
    <DiagramLabel x={120} y={212} lines={labelsByKind['plei'][2]} />
    <DiagramLabel x={310} y={130} lines={labelsByKind['plei'][3]} />
    <DiagramLabel x={517} y={130} lines={labelsByKind['plei'][4]} />
    <DiagramLabel node={false} x={300} y={278} lines={labelsByKind['plei'][5]} />
</svg>}
  {slug === 'veciapp' && <svg class="diagram-wide" viewBox="0 0 600 260" aria-hidden="true" focusable="false">
    <path class={styles.flow} d="M170 71H205V110H235M170 188H205V150H235M365 130H410V64H454M410 130V195H454" />
    <rect class={styles.node} x="45" y="40" width="125" height="62" rx="5" />
    <rect class={styles.node} x="45" y="157" width="125" height="62" rx="5" />
    <rect class={styles.accent} x="235" y="87" width="130" height="87" rx="8" />

    <rect class={styles.node} x="454" y="32" width="136" height="62" rx="5" />
    <rect class={styles.node} x="454" y="166" width="136" height="62" rx="5" />


    <DiagramLabel x={107} y={71} lines={labelsByKind['veciapp'][0]} />
    <DiagramLabel x={107} y={188} lines={labelsByKind['veciapp'][1]} />
    <DiagramLabel x={300} y={130} lines={labelsByKind['veciapp'][2]} />
    <DiagramLabel x={522} y={64} lines={labelsByKind['veciapp'][3]} />
    <DiagramLabel x={522} y={195} lines={labelsByKind['veciapp'][4]} />
</svg>}
  {slug === 'maleua' && <svg class="diagram-wide" viewBox="0 0 600 260" aria-hidden="true" focusable="false">
    <path class={styles.flow} d="M145 130H170M300 130H325M455 130H480" />
    <path class={styles.node} d="M25 51h120v158H25z" />
    <path class={styles.accent} d="M170 68h130v124H170z" />
    <path class={styles.node} d="M325 59h130v142H325z" />
    <path class={styles.accent} d="M480 91h110v78H480z" />

    <DiagramLabel x={85} y={130} lines={labelsByKind['maleua'][0]} />
    <DiagramLabel x={235} y={130} lines={labelsByKind['maleua'][1]} />
    <DiagramLabel x={390} y={130} lines={labelsByKind['maleua'][2]} />
    <DiagramLabel x={535} y={130} lines={labelsByKind['maleua'][3]} />
</svg>}
  </DiagramFrame>
</figure>
