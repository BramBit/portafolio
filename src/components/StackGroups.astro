---
import styles from './StackGroups.module.css';
import type { StackGroup } from '../data/stack';
interface Props { groups: StackGroup[]; class?: string; }
const { groups, class: className = '' } = Astro.props;
---
<div class:list={[styles.groups, className]}>
  {groups.map((group) => <section class={styles.group} aria-labelledby={`stack-${group.id}`}>
    <h3 id={`stack-${group.id}`} class={styles.label}>{group.label}</h3>
    <ul class={styles.items}>{group.items.map((item) => <li>{item.name}</li>)}</ul>
  </section>)}
</div>
