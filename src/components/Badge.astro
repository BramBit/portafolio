---
import styles from './Badge.module.css';

interface Props {
  variant?: 'default' | 'primary' | 'accent';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'default',
  class: className = '',
  ...rest
} = Astro.props;

const badgeClasses = [
  styles.badge,
  styles[variant],
  className
].filter(Boolean).join(' ');
---

<span class={badgeClasses} {...rest}>
  <slot />
</span>
