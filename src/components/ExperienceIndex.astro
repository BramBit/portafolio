---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Section from './Section.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import CTASection from './CTASection.astro';
import ExperienceGroups from './ExperienceGroups.astro';
import { getExperienceGroups, type ExperienceLang } from '../data/experience';
import styles from './ExperienceIndex.module.css';
interface Props { lang: ExperienceLang; }
const { lang } = Astro.props;
const groups = getExperienceGroups(await getCollection('case-studies'), lang);
const copy = lang === 'es' ? {
  title: 'Experiencia', intro: 'Sistemas desarrollados en Belvi Digital y Alaska Tech. Cada caso presenta el contexto, mi contribución y las decisiones técnicas.',
  jump: 'Ir a empresa', ctaTitle: '¿Tienes un proyecto en desarrollo?', ctaDescription: 'Cuéntame qué estás construyendo y revisamos dónde puedo aportar.', ctaButton: 'Hablemos', contact: '/es/contacto',
} : {
  title: 'Experience', intro: 'Systems built at Belvi Digital and Alaska Tech. Each case presents its context, my contribution, and technical decisions.',
  jump: 'Jump to company', ctaTitle: 'Have a project in development?', ctaDescription: "Tell me what you're building and we can review where I can contribute.", ctaButton: "Let's talk", contact: '/contact',
};
---
<Layout title={`${copy.title} — Brayan Mercado`} description={copy.intro}>
  <Section class={styles.intro}>
    <Container>
      <Heading level={1}>{copy.title}</Heading>
      <p>{copy.intro}</p>
      <nav class={styles.jump} aria-label={copy.jump}>{groups.map((group) => <a href={`#${group.key}`}>{group.company.name}<span aria-hidden="true">↓</span></a>)}</nav>
    </Container>
  </Section>
  <Section class={styles.body}>
    <Container><ExperienceGroups groups={groups} lang={lang} mode="index" /></Container>
  </Section>
  <CTASection title={copy.ctaTitle} description={copy.ctaDescription} button={{ label: copy.ctaButton, href: copy.contact, variant: 'primary' }} />
</Layout>
