---
import Container from './Container.astro';
import Button from './Button.astro';
import styles from './Hero.module.css';

interface ButtonConfig {
  label: string;
  href?: string;
  onClick?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any;
}

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  primaryButton?: ButtonConfig;
  secondaryButton?: ButtonConfig;
  showGlow?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  primaryButton,
  secondaryButton,
  showGlow = true,
  class: className = '',
} = Astro.props;
---

<section class:list={[styles.heroSection, className]}>
  {showGlow && <div class={styles.glowBackground} aria-hidden="true" />}

  <Container class={styles.content}>
    {subtitle && <p class={styles.subtitle}>{subtitle}</p>}

    <h1 class={styles.title}>{title}</h1>

    <p class={styles.description}>{description}</p>

    {
      (primaryButton || secondaryButton) && (
        <div class={styles.actions}>
          {primaryButton && (
            <Button
              variant="primary"
              href={primaryButton.href}
              type={primaryButton.type}
              {...primaryButton}
            >
              {primaryButton.label}
            </Button>
          )}

          {secondaryButton && (
            <Button
              variant="secondary"
              href={secondaryButton.href}
              type={secondaryButton.type}
              {...secondaryButton}
            >
              {secondaryButton.label}
            </Button>
          )}
        </div>
      )
    }
  </Container>
</section>
