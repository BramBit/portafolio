---
import styles from './Tag.module.css';

interface Props {
  class?: string;
  [key: string]: any;
}

const {
  class: className = '',
  ...rest
} = Astro.props;

const tagClasses = [
  styles.tag,
  className
].filter(Boolean).join(' ');
---

<span class={tagClasses} {...rest}>
  <slot />
</span>
